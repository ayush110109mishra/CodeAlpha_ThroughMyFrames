# ==============================================================================
# Through My Frames 2.0 — Frontend Environment Configuration Template
# ==============================================================================
# IMPORTANT: All variables prefixed with `VITE_` are baked statically into
# the client-side JavaScript bundle during `npm run build`.
# 
# In production on Vercel:
# 1. Add VITE_API_URL pointing to your Render backend API (e.g., https://your-backend.onrender.com/api)
# 2. Redeploy the frontend whenever this variable changes.
# ==============================================================================

# Backend REST API endpoint URL
VITE_API_URL=http://localhost:5000/api

# Set to 'true' ONLY if you explicitly want the client to use static offline mock fixtures.
# By default ('false'), the application connects to the live backend API and renders friendly
# error cards with retry buttons if the server is offline or spinning up.
VITE_USE_MOCK=false
