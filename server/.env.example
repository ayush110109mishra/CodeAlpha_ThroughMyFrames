# ==============================================================================
# Through My Frames 2.0 - Backend Environment Variables
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example for local: mongodb://127.0.0.1:27017/through-my-frames
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/through-my-frames?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/through-my-frames

# Client URL allowed for CORS
CLIENT_URL=http://localhost:5173

