# ==============================================================================
# Through My Frames 2.0 — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to server/.env for local development:
#   cp server/.env.example server/.env
#
# On Render (Production Web Service):
# Add these variables under "Environment" in your service dashboard.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Client Origins for Cross-Origin Resource Sharing (CORS)
# Supports comma-separated origins (e.g. Vercel production + Vercel preview URLs)
# Example: https://through-my-frames.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173,http://localhost:4173

# MongoDB Connection String (Atlas Cluster or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# On Atlas, configure Network Access to 0.0.0.0/0 (Render server IPs rotate dynamically).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/through-my-frames?retryWrites=true&w=majority

# JWT Token Secret & Lifespan
# IN PRODUCTION: Must be at least 32 characters long and cannot be a default/sample string.
# Generate high entropy via: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Cloudinary Storage Credentials (for photographic asset uploads)
# Sign up at https://cloudinary.com to retrieve these from your dashboard.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Database Seeding Security
# Used by `npm run seed` to initialize @ayushmishra with a known secure password.
SEED_OWNER_PASSWORD=YourSecureOwnerPassword123!

# Registration Access Control (default 'true')
# When set to 'false', POST /api/auth/signup returns 403 Forbidden.
ALLOW_SIGNUP=true

